# Copy this file to .env.local and fill in your values.
# .env.local is gitignored and must never be committed.

# --- inQueue SSO (shared with the hub and every other tool) ---
# Same value as the hub's INQUEUE_SESSION_SECRET — see root .env.example.
INQUEUE_SESSION_SECRET=CHANGE_ME_32_BYTES_HEX
INQUEUE_HUB_URL=http://localhost:4000
# Client-side twin of INQUEUE_HUB_URL — must be set to the SAME value.
# Required because Next.js only inlines env vars into the browser bundle when
# they carry the NEXT_PUBLIC_ prefix; the sidebar hub link and logout button
# read this one, server routes read INQUEUE_HUB_URL.
NEXT_PUBLIC_INQUEUE_HUB_URL=http://localhost:4000
# Batchly's OWN public URL — builds Etsy/Google OAuth callback redirects.
NEXT_PUBLIC_BASE_URL=http://localhost:3030

# --- Store Configuration hub sync (set on Batchly AND Preply, not the hub) ---
# local (default) — Batchly keeps its own Postgres rows; hub sync runs
#                    dry-run only and reports a field diff.
# hub             — hub-pushed config is applied via Prisma upserts. Flip only
#                    after the empty-diff check in
#                    docs/plans/store-config-hub-plan.md.
# INQUEUE_STORE_CONFIG_SOURCE=local

# Postgres connection string — REQUIRED everywhere (docs/deployment.md §3).
# The Prisma datasource is postgresql; SQLite is no longer supported. Local
# dev needs a local PostgreSQL, e.g.:
#   brew install postgresql@16 && brew services start postgresql@16
#   createdb batchly_dev
# then: npx prisma migrate deploy && npx prisma db seed
DATABASE_URL="postgresql://localhost:5432/batchly_dev"

# Google OAuth2 credentials (from Google Cloud Console)
# 1. Create project at https://console.cloud.google.com/
# 2. Enable the Google Drive API
# 3. Credentials → Create OAuth 2.0 Client ID → Web application
# 4. Authorized redirect URI: http://localhost:3030/api/auth/google/callback
# This is Batchly's OWN OAuth client (Drive import broker) — a different
# Google Cloud OAuth client than Preply's. Preply reads different env var
# names (GOOGLE_OAUTH_CLIENT_ID / GOOGLE_OAUTH_CLIENT_SECRET) for its own
# separate client; do not reuse one client's credentials for the other app,
# and do not set GOOGLE_OAUTH_CLIENT_ID here — Batchly does not read it.
# NOTE: the Google refresh token earned from the connect flow is stored in the
# database (AppSetting row), NOT in .tokens/google.json — no persistent disk
# is needed for it. A legacy .tokens/google.json is imported once if present.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# The Drive folder ID that contains all pending batch subfolders
# Find it in the URL when you open the folder: drive.google.com/drive/folders/<ID>
GOOGLE_DRIVE_PENDING_FOLDER_ID=

# OAuth callback URL — must match exactly what you registered in Google Cloud Console
GOOGLE_REDIRECT_URI=http://localhost:3030/api/auth/google/callback

# Etsy OAuth2 PKCE credentials (from https://www.etsy.com/developers/your-apps)
# 1. Create or select your app at the Etsy developer portal
# 2. Add this redirect URI to your app: http://localhost:3030/api/auth/etsy/callback
# Note: Etsy API v3 PKCE does NOT use a client secret for token exchange.
#       ETSY_CLIENT_SECRET is unused by the implementation but listed for completeness.
ETSY_CLIENT_ID=
ETSY_CLIENT_SECRET=
ETSY_REDIRECT_URI=http://localhost:3030/api/auth/etsy/callback
ETSY_SCOPES=shops_r listings_r listings_w

# Phase 6A — test draft listing only (Store A)
# taxonomy_id: find via Etsy Seller Dashboard → Add listing → Category, or GET /v3/application/seller-taxonomy/nodes
# shipping_profile_id: Etsy Seller Dashboard → Shop Manager → Shipping settings (ID appears in URL when editing)
# shipping_profile_id is optional — Etsy may accept draft creation without it
ETSY_TEST_TAXONOMY_ID=
ETSY_TEST_SHIPPING_PROFILE_ID=
