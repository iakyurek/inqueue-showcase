{
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  // scripts/ are dev-only tools run via tsx (tests, smoke checks). They are not
  // part of the deployed app and must not be type-checked by `next build` —
  // some reach into the repo root (../../lib), which does not exist in Render's
  // per-service (batchly/) build context and broke the deploy.
  "exclude": ["node_modules", "scripts"]
}
