# inQueue shared authentication (Phase 1A)
# Copy to .env.local and fill in. .env.local is gitignored.

# Root hub port (default 4000)
PORT=4000

# Where Preply/Inkly/Batchly send unauthenticated browsers. Each tool redirects
# to INQUEUE_HUB_URL/auth/launch?tool=<tool>&next=<path>; the hub mints a
# short-lived SSO ticket and bounces back to the tool's SSO callback, which sets
# that tool's own first-party session cookie. So every tool service ALSO needs
# INQUEUE_HUB_URL + INQUEUE_SESSION_SECRET (below) set.
# On localhost this is the hub URL; on Render, the public hub URL.
# NOTE: never use a Domain=.onrender.com cookie — .onrender.com is a shared
# public suffix. SSO is what makes per-origin cookies work.
INQUEUE_HUB_URL=http://localhost:4000

# Base URLs for each tool. The hub uses these for its dashboard tool links
# and its Batchly summary aggregator. Every URL is safe to expose to
# authenticated frontends via /config.js — none of them is a secret.
INKLY_BASE_URL=http://localhost:5500
PREPLY_BASE_URL=http://localhost:3001
BATCHLY_BASE_URL=http://localhost:3030

# --- Session cookie ---
# 32+ random bytes hex-encoded. Same value MUST be set on every app
# (hub + inkly + preply + batchly) so cookies verify everywhere.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INQUEUE_SESSION_SECRET=CHANGE_ME_32_BYTES_HEX

# --- Store Configuration (hub source of truth) ---
# Postgres connection string for the hub's store-config storage. REQUIRED in
# production (Render managed Postgres). When unset, the hub falls back to a
# local JSON file (data/store-config.json) — dev only; production guardrails
# fail closed on a missing/localhost/file: value.
# INQUEUE_DATABASE_URL=postgres://user:password@host:5432/inqueue
# Free-tier Render Postgres is deleted ~30 days after creation. Copy the
# expiry date from the Render database page so the hub can count down and
# warn loudly in its Connections view (see scripts/backup-inqueue-db.sh).
# INQUEUE_DB_EXPIRES_AT=2026-08-10

# Per-tool feature flag (set on Preply and Batchly, NOT the hub): where each
# tool takes its store configuration from.
#   local (default) — tool keeps its own config; hub sync runs in dry-run mode
#   hub             — hub-pushed config is applied (flip only after the
#                     empty-diff check in docs/plans/store-config-hub-plan.md)
# INQUEUE_STORE_CONFIG_SOURCE=local

# --- Credentials ---
INQUEUE_USERNAME=KIV_LLC

# PBKDF2-SHA256 hash of the password. Format:  pbkdf2$<iters>$<saltHex>$<hashHex>
# Generate with:
#   node -e "const c=require('crypto');const s=c.randomBytes(16);const h=c.pbkdf2Sync(process.argv[1],s,100000,32,'sha256');console.log('pbkdf2\$100000\$'+s.toString('hex')+'\$'+h.toString('hex'))" 'YOUR_PASSWORD'
INQUEUE_PASSWORD_HASH=pbkdf2$100000$REPLACE_SALT_HEX$REPLACE_HASH_HEX

# Dev-only fallback if INQUEUE_PASSWORD_HASH is not set (do not use in production).
# INQUEUE_PASSWORD=
