# ----------------------------------------------------------------------------
# inkly environment configuration
#
#   1. Copy this file to .env :   cp .env.example .env
#   2. Paste your OpenAI key into OPENAI_API_KEY below.
#   3. Run the app:              npm start
#
# Never commit your real .env to GitHub (.gitignore already excludes it).
# inkly runs WITHOUT a key in "demo mode" (deterministic SVG designs + local
# image cleanup). Add the key to unlock AI briefs, reference vision, and AI art.
# ----------------------------------------------------------------------------

PORT=5500

# --- OpenAI (server-side only — never shipped to the browser) ----------------
# Get a key at https://platform.openai.com/api-keys
# Note: ChatGPT Plus is separate from API billing; you need a Platform key.
OPENAI_API_KEY=sk-proj-your-key-here
OPENAI_TEXT_MODEL=gpt-4o
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_SIZE=1024x1536
# "high" = best detail (recommended for print). Switch to "medium" to roughly
# halve per-image generation time and cost if detail loss is acceptable.
OPENAI_IMAGE_QUALITY=high
# Per-request timeout so one hung OpenAI call can't stall a generation slot.
OPENAI_TIMEOUT_MS=180000

# --- Generation throughput ----------------------------------------------------
# How many designs generate in parallel across ALL jobs and users (default 3,
# max 6). One 15-design job fans out across every slot; a teammate's job gets
# slots as soon as a design finishes. (Replaces INKLY_GENERATION_LANES.)
INKLY_DESIGN_CONCURRENCY=3
# The finishing pipeline (transparency + upscale + 4500x5400 compose) is
# memory-heavy; it runs one design at a time by default. Raise only if the
# instance has well over 512 MB of RAM.
INKLY_COMPOSE_CONCURRENCY=1

# --- Automated design QA gate -------------------------------------------------
# Every AI-generated design is reviewed by a vision model against a hard rubric
# (exact spelling, no covered/clipped letters, no stray text, clean centered
# composition) BEFORE it is saved. Failing designs are regenerated with the
# reviewer's feedback; if every attempt fails, the design errors out instead of
# being presented. Set DESIGN_QA=off to disable (not recommended in production).
DESIGN_QA=on
DESIGN_QA_MAX_ATTEMPTS=3
# Vision model used for the review (defaults to OPENAI_TEXT_MODEL, then gpt-4o).
OPENAI_QA_MODEL=
# Folder of your best real design PNGs/JPGs used as quality-bar references
# (up to 2 picked at random per generation). Defaults to inkly/style-references.
STYLE_REFERENCE_DIR=

# Set true to exercise the whole app without spending any API credits.
USE_PLACEHOLDER_IMAGES=false

# --- Transparent-PNG cleanup pipeline ---------------------------------------
# AI art is generated on this flat chroma background; the backend removes it
# and exports real transparency. Do not use this color inside the artwork.
DESIGN_CHROMA_COLOR=#FF00FF
DESIGN_CHROMA_THRESHOLD=65
DESIGN_CHROMA_FEATHER=30
DESIGN_EDGE_BG_THRESHOLD=36
DESIGN_CLEANUP_MAX_SIZE=2048

# --- Final export ------------------------------------------------------------
DEFAULT_CANVAS_WIDTH=4500
DEFAULT_CANVAS_HEIGHT=5400
EXPORT_DPI=300

# --- Upscaler ----------------------------------------------------------------
# inkly always uses high-quality Lanczos-3 (via sharp) for upscaling.
# For genuine super-resolution on low-res uploads, plug in a model provider:
# set UPSCALE_PROVIDER=replicate and add your Replicate token. Leave blank to
# use Lanczos only.
UPSCALE_PROVIDER=
REPLICATE_API_TOKEN=
UPSCALE_MODEL=nightmareai/real-esrgan
UPSCALE_TARGET_LONG_EDGE=4200

# Max regeneration/reprocessing attempts the evaluator may request.
MAX_REGEN_ATTEMPTS=3
