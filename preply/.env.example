# Preply local dev env template. Copy to .env.local and fill in.

# --- inQueue SSO (shared with the hub and every other tool) ---
# Same value as the hub's INQUEUE_SESSION_SECRET — see root .env.example.
INQUEUE_SESSION_SECRET=CHANGE_ME_32_BYTES_HEX
INQUEUE_HUB_URL=http://localhost:4000

# --- Store Configuration hub sync (set on Preply AND Batchly, not the hub) ---
# local (default) — Preply keeps its own stores.json; hub sync runs dry-run only.
# hub             — hub-pushed config is applied. Flip only after the
#                    empty-diff check in docs/plans/store-config-hub-plan.md.
# INQUEUE_STORE_CONFIG_SOURCE=local

# --- Durable state (no-disk deploys) ---
# Postgres connection string for Preply's durable state (stores, batches,
# settings, SKU ledger, mockup presets, Google Drive refresh token, Drive
# export report). When set, every state write goes through to a preply_state
# table and boot re-hydrates the data files from it — so Render deploys need
# NO persistent disk. May point at the same Postgres instance as the hub's
# INQUEUE_DATABASE_URL (the table is namespaced). Unset = disk-only (dev).
# PREPLY_DATABASE_URL=postgres://user:password@host:5432/inqueue

# --- Google Drive adapter ---
# mock:            local filesystem stand-in, safe for tests (no Drive calls).
# service_account: service-account key at GOOGLE_SERVICE_ACCOUNT_KEY_PATH.
# oauth:           OAuth user upload — required for real My-Drive folders
#                  (service accounts hit storageQuotaExceeded on personal folders).
GOOGLE_DRIVE_AUTH_MODE=mock
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./google-service-account.json

# OAuth client for GOOGLE_DRIVE_AUTH_MODE=oauth — Preply's OWN Google Cloud
# OAuth client. NOT the same variable names Batchly uses (GOOGLE_CLIENT_ID /
# GOOGLE_CLIENT_SECRET) — Preply and Batchly each register a separate OAuth
# client, and the code reads different env var names for each.
# Redirect URI registered in Google Cloud Console must match exactly.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3001/api/drive/oauth/callback

# --- Batchly handoff mode (Phase 3) ---
# local: write only into ../batchly/workspace/downloads/<batchId> (dev default).
# drive: upload only to the Drive Pending Batches folder (Render/prod).
# both:  do both; fail the whole handoff if either fails (transitional).
# drive (recommended in prod): export goes server->Drive pending-batches folder,
# no browser ZIP is built, and Preply pings Batchly to auto-scan the new batch.
PREPLY_BATCHLY_HANDOFF_MODE=local

# --- Pending Batches Drive folder ID ---
# Required when PREPLY_BATCHLY_HANDOFF_MODE is drive or both.
# The Google Drive folder Batchly scans for incoming Preply batches; must be
# shared with the OAuth user (or service account) that Preply uses.
PREPLY_PENDING_BATCHES_FOLDER_ID=
